# Supabaseプロジェクトの Project Settings > API から取得して .env.local にコピーしてください
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase Service Role Key（webhook用。サーバー専用・決してクライアントに渡さない）
SUPABASE_SERVICE_ROLE_KEY=

# Stripe（Dashboard > Developers > API keys / Products）
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Stripe Webhook署名秘密鍵（Dashboard > Webhooks または stripe listen の出力）
STRIPE_WEBHOOK_SECRET=
