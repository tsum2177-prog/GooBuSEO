# Supabaseプロジェクトの Project Settings > API から取得して .env.local にコピーしてください
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase Service Role Key（webhook・Google連携用。サーバー専用・決してクライアントに渡さない）
SUPABASE_SERVICE_ROLE_KEY=

# Stripe（Dashboard > Developers > API keys / Products）
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Stripe Webhook署名秘密鍵（Dashboard > Webhooks または stripe listen の出力）
STRIPE_WEBHOOK_SECRET=

# Google Business Profile 連携（Google Cloud Console > APIs & Services > 認証情報）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# Googleトークン暗号化キー（32バイト=64文字のhex。openssl rand -hex 32 で生成）
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Gemini（AI返信の生成）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# レビュー自動取得用（/api/reviews/sync の呼び出し認可。ランダムな文字列を設定）
CRON_SECRET=
