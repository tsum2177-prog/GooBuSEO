# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# 注意: ルート直下の .env は wrangler のビルド設定（WRANGLER_BUILD_*）を保持するため追跡対象。
# ここに秘密情報を書き込むとコミットされる。秘密は .env.local / .dev.vars に置き、
# Cloudflare では `wrangler secret put` を使うこと。
.env*
!.env.example
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# command code
/.commandcode/

# cloudflare
/.open-next/
/.dev.vars
/.wrangler/
/cloudflare-env.d.ts

# build logs (open-next の dev 初期化が生成する)
build.log
build.err.log
